// Copy this file to secrets_local.h and fill it in locally.
// secrets_local.h is ignored by Git. Never commit real credentials.
#define WIFI_SSID "YOUR_WIFI_NETWORK"
#define WIFI_PASS "YOUR_WIFI_PASSWORD"
#define DEVICE_API_TOKEN "SET_TO_THE_SERVER_IOT_DEVICE_TOKEN"

// Keep 0 until the wiring, pump, thresholds, and emergency stop are verified.
// Server-side PUMP_CONTROL_ENABLED must also be explicitly set to true.
#define PUMP_CONTROL_ENABLED 0
